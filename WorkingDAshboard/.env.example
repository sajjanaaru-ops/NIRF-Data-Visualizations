# Copy this file to .env and paste your Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-key-here

# Optional: main model (default gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Optional: backup models tried in order when the main one is overloaded,
# rate-limited, timing out or unavailable.
# Default: gemini-3.6-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite
# Set it to an empty value to disable fallbacks.
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
